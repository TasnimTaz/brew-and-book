# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/brew_and_book?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth / OTP
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=""
TOKEN_SECRET=""
OTP_EXPIRY_MINUTES=5
ADMIN_SESSION_SECRET=""
CRON_SECRET=""

# SMS provider (Bangladesh) - fill when account is approved
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_API_URL=""

# Payment - SSLCommerz sandbox/live
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

# Admin
ADMIN_EMAIL="admin@brewbook.local"
ADMIN_PASSWORD=""

# Online payment (SSLCommerz). Leave the store id/password blank to hide the online option.
# The success/fail/cancel callbacks use NEXT_PUBLIC_APP_URL. The IPN call needs a PUBLIC url (e.g. an ngrok tunnel while on localhost).
# Amount charged online when the booking has no pre-ordered items:
BOOKING_DEPOSIT_BDT=100

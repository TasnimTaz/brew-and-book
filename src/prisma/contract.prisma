// use prisma-8

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum TableStatus {
  AVAILABLE
  HELD
  BOOKED
  OCCUPIED
  UNAVAILABLE
}

enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  UNPAID
}

enum PaymentMethod {
  ONLINE
  PAY_AT_SHOP
  DEPOSIT
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  email     String?
  role      Role     @default(CUSTOMER)
  bookings  Booking[]
  otpCodes  OtpCode[]
  createdAt DateTime @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Table {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  seats     Int
  zone      String
  x         Float
  y         Float
  shape     String    @default("rect")
  width     Float     @default(80)
  height    Float     @default(80)
  photoUrl  String?
  active    Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model TimeSlot {
  id        Int       @id @default(autoincrement())
  start     String
  end       String
  label     String
  active    Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@unique([start, end])
}

model Booking {
  id          Int           @id @default(autoincrement())
  token       String        @unique
  serial      Int
  table       Table         @relation(fields: [tableId], references: [id])
  tableId     Int
  user        User          @relation(fields: [userId], references: [id])
  userId      Int
  date        DateTime
  slot        TimeSlot      @relation(fields: [slotId], references: [id])
  slotId      Int
  guests      Int
  status      BookingStatus @default(HELD)
  note        String?
  holdExpiresAt DateTime?
  qrPayload   String?
  orders      Order[]
  payments    Payment[]
  createdAt   DateTime      @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt

  @@index([date, slotId])
  @@index([userId])
}

model MenuCategory {
  id        Int        @id @default(autoincrement())
  name      String
  nameBn    String?
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model MenuItem {
  id          Int          @id @default(autoincrement())
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  categoryId  Int
  name        String
  nameBn      String?
  description String?
  priceBdt    Int
  imageUrl    String?
  options     Json?
  tags        String[]     @default([])
  available   Boolean      @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt
}

model Order {
  id         Int         @id @default(autoincrement())
  booking    Booking     @relation(fields: [bookingId], references: [id])
  bookingId  Int
  totalBdt   Int
  items      OrderItem[]
  createdAt  DateTime    @default(now()) @onCreate(now())
  updatedAt  temporal.UpdatedAt
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId Int
  quantity   Int
  unitPriceBdt Int
  options    Json?
  createdAt  DateTime @default(now()) @onCreate(now())
  updatedAt  temporal.UpdatedAt
}

model Payment {
  id             Int           @id @default(autoincrement())
  booking        Booking       @relation(fields: [bookingId], references: [id])
  bookingId      Int
  gateway        String
  method         PaymentMethod @default(ONLINE)
  amountBdt      Int
  status         PaymentStatus @default(PENDING)
  gatewayTxnId   String?
  rawResponse    Json?
  createdAt      DateTime      @default(now()) @onCreate(now())
  updatedAt      temporal.UpdatedAt

  @@index([bookingId])
  @@index([gatewayTxnId])
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
  phone     String
  codeHash  String
  expiresAt DateTime
  verifiedAt DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @onCreate(now())

  @@index([phone])
}
